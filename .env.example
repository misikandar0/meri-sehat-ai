# ==============================================================================
# MERI SEHAT AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. Never commit real keys to source control.
# ==============================================================================

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# AI Provider Configuration (Optional - Defaults to Deterministic Clinical Rules Engine if omitted)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Supabase (Optional - Defaults to Private Browser Client Storage if omitted)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Payment Integration (Abstract Provider - Defaults to Safe Sandbox Test Mode)
PAYMENT_MODE=test_mode
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
